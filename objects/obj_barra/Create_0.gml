
muro = noone;           // Guarda el muro al que pertenece esta barra (el muro lo asigna al crearla)
sprite_index = spt_barra; // Asigna el sprite de la barra a este objeto
image_index = 0;        // Empieza en el frame 0 (verde)
image_speed = 0;        // Evita que el sprite cambie de frame solo (animación detenida)
visible = false;        // La barra empieza invisible porque el muro empieza con la vida completa